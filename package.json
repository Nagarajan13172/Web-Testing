{
  "name": "web-testing",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @webtesting/web dev",
    "build": "pnpm --filter @webtesting/web build",
    "start": "pnpm --filter @webtesting/web start",
    "worker": "pnpm --filter @webtesting/worker dev",
    "db:generate": "pnpm --filter @webtesting/db generate",
    "db:migrate": "pnpm --filter @webtesting/db migrate",
    "db:studio": "pnpm --filter @webtesting/db studio",
    "sandbox:build": "docker build -f docker/node.Dockerfile -t webtesting/node:latest docker",
    "sandbox:pull-playwright": "docker pull mcr.microsoft.com/playwright:v1.50.0-noble",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
