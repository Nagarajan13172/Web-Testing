DATABASE_URL=postgres://app:app@localhost:5433/webtesting
REDIS_URL=redis://localhost:6379

# Clerk — get keys at https://dashboard.clerk.com → API Keys.
# Enable GitHub social connection in User & Authentication → Social Connections.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# GitHub App — create at https://github.com/settings/apps/new.
# Callback URL: http://localhost:3000/api/github/callback
# Webhook URL:  https://smee.io/<your-channel>  (forwarded to /api/github/webhook locally)
# Permissions:  Contents R, Metadata R, Pull requests RW, Checks W
# Events:       push, pull_request, installation, installation_repositories
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
PASTE_PEM_CONTENTS_HERE
-----END RSA PRIVATE KEY-----"

# smee channel — the same URL you set as the GitHub App webhook target.
# Run `npx smee-client --url $SMEE_URL --target http://localhost:3000/api/github/webhook`
# in a terminal whenever you want pushes to trigger runs locally.
SMEE_URL=https://smee.io/your-channel

SECRET_VAULT_KEY=base64-32-bytes-of-randomness

# Required for AI failure explanation (MVP step 6) and later AI features.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
